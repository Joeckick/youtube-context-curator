# YouTube Digest Configuration
# Copy this file to .env and fill in your values

# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api...

# Resend API key from resend.com/api-keys
RESEND_API_KEY=re_...

# OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY

# Email addresses
# For testing, you can use onboarding@resend.dev as the FROM address
# For production, verify your own domain in Resend
EMAIL_FROM=YouTube Digest <onboarding@resend.dev>
EMAIL_TO=your.email@example.com
